#!/bin/sh
. "$(dirname "$0")/common"

is_running() {
    [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

start_daemon() {
    is_running && return 0
    bin=$(binary_path) || exit 1
    port=$(config_get PORT "$DEFAULT_PORT")
    upstream=$(config_get UPSTREAM "$DEFAULT_UPSTREAM")

    # The proxy logs every API call; keep one previous log around.
    if [ -f "$LOG_FILE" ] && [ "$(wc -c < "$LOG_FILE")" -gt "$LOG_MAX_BYTES" ]; then
        mv -f "$LOG_FILE" "$LOG_FILE.1"
    fi

    echo "$(date '+%F %T') starting on port $port -> $upstream" >> "$LOG_FILE"
    nohup "$bin" --listen "0.0.0.0:$port" --upstream "$upstream" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"

    sleep 1
    if ! is_running; then
        echo "dsvideo-passthrough failed to start, see $LOG_FILE" >&2
        rm -f "$PID_FILE"
        exit 1
    fi
}

stop_daemon() {
    if is_running; then
        pid=$(cat "$PID_FILE")
        kill "$pid"
        i=0
        while kill -0 "$pid" 2>/dev/null && [ $i -lt 10 ]; do
            sleep 1
            i=$((i + 1))
        done
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid"
    fi
    rm -f "$PID_FILE"
}

case "$1" in
    start)   start_daemon ;;
    stop)    stop_daemon ;;
    restart) stop_daemon; start_daemon ;;
    status)  is_running || exit 3 ;;
    log)     echo "$LOG_FILE" ;;
    *)       exit 1 ;;
esac
exit 0
