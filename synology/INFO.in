package="dsvideo_passthrough"
version="@VERSION@"
os_min_ver="7.0-40000"
arch="noarch"
displayname="DS Video HEVC Passthrough"
description="Proxy in front of Video Station: when DS Video asks for an HLS remux that Video Station refuses (HEVC, error 1211), the file is re-opened in raw mode and passed through untouched instead of being transcoded. Point DS Video at this NAS on the proxy port (default 5080)."
maintainer="Holger Trahe"
thirdparty="yes"
startable="yes"
silent_upgrade="yes"
install_dep_packages="VideoStation"
